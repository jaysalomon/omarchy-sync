pkgname=omarchy-sync
pkgver=0.5.0
pkgrel=1
pkgdesc='Trusted multi-machine continuity service for Omarchy'
arch=('x86_64')
url='https://github.com/jaysalomon/omarchy-sync'
license=('MIT')
depends=('systemd' 'polkit' 'hyprpolkitagent' 'libnotify' 'zenity' 'openssh' 'sshfs' 'rsync' 'pciutils' 'sudo' 'util-linux')
makedepends=('cargo')
install="$pkgname.install"
source=()

prepare() {
  mkdir -p "$srcdir/$pkgname-$pkgver"
  git -C "$startdir/../.." archive --format=tar HEAD | tar -x -C "$srcdir/$pkgname-$pkgver"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/omarchy-syncd "$pkgdir/usr/lib/omarchy-sync/omarchy-syncd"
  install -Dm755 packaging/arch/omarchy-sync-upgrade-helper "$pkgdir/usr/lib/omarchy-sync/omarchy-sync-upgrade-helper"
  install -Dm755 bin/omarchy-sync-upgrade "$pkgdir/usr/bin/omarchy-sync-upgrade"
  install -Dm755 bin/omarchy-sync-propagate "$pkgdir/usr/bin/omarchy-sync-propagate"
  install -Dm755 bin/omarchy-sync-data "$pkgdir/usr/bin/omarchy-sync-data"
  install -dm750 "$pkgdir/etc/sudoers.d"
  install -Dm440 packaging/arch/omarchy-sync.sudoers "$pkgdir/etc/sudoers.d/omarchy-sync"
  install -Dm644 systemd/omarchy-sync-propagate.service "$pkgdir/usr/lib/systemd/user/omarchy-sync-propagate.service"
  install -Dm644 systemd/omarchy-sync-propagate.timer "$pkgdir/usr/lib/systemd/user/omarchy-sync-propagate.timer"
  install -Dm644 systemd/omarchy-sync-data.service "$pkgdir/usr/lib/systemd/user/omarchy-sync-data.service"
  install -Dm644 systemd/omarchy-sync-data.timer "$pkgdir/usr/lib/systemd/user/omarchy-sync-data.timer"
  install -Dm644 systemd/omarchy-syncd.service "$pkgdir/usr/lib/systemd/user/omarchy-syncd.service"
  install -Dm644 packaging/arch/org.omarchy.sync.policy "$pkgdir/usr/share/polkit-1/actions/org.omarchy.sync.policy"
  install -Dm644 packaging/arch/sshd_config.conf "$pkgdir/etc/ssh/sshd_config.d/90-omarchy-sync.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/ACCEPTANCE.md "$pkgdir/usr/share/doc/$pkgname/ACCEPTANCE.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
