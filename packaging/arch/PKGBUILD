pkgname=omarchy-sync
pkgver=0.1.5
pkgrel=1
pkgdesc='Trusted multi-machine continuity service for Omarchy'
arch=('x86_64')
url='https://github.com/jaysalomon/omarchy-sync'
license=('MIT')
depends=('systemd' 'polkit' 'hyprpolkitagent' 'openssh')
makedepends=('cargo')
install="$pkgname.install"
source=()

prepare() {
  mkdir -p "$srcdir/$pkgname-$pkgver"
  git -C "$startdir/../.." archive --format=tar HEAD | tar -x -C "$srcdir/$pkgname-$pkgver"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/omarchy-syncd "$pkgdir/usr/lib/omarchy-sync/omarchy-syncd"
  install -Dm644 systemd/omarchy-syncd.service "$pkgdir/usr/lib/systemd/user/omarchy-syncd.service"
  install -Dm644 systemd/omarchy-sync-polkit-agent.service "$pkgdir/usr/lib/systemd/user/omarchy-sync-polkit-agent.service"
  install -Dm644 packaging/arch/org.omarchy.sync.policy "$pkgdir/usr/share/polkit-1/actions/org.omarchy.sync.policy"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/ACCEPTANCE.md "$pkgdir/usr/share/doc/$pkgname/ACCEPTANCE.md"
}
