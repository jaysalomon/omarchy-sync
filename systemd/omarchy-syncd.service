[Unit]
Description=OmarchySync trusted user daemon
Documentation=https://github.com/jaysalomon/omarchy-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/omarchy-sync/omarchy-syncd
Environment=OMARCHY_SYNCD_STATE_DIR=/var/lib/omarchy-sync
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
