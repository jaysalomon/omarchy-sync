[Unit]
Description=OmarchySync trusted user daemon
Documentation=https://github.com/jaysalomon/omarchy-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/omarchy-sync/omarchy-syncd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
