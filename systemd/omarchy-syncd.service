[Unit]
Description=OmarchySync trusted system daemon
Documentation=https://github.com/jaysalomon/omarchy-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/omarchy-sync/omarchy-syncd
Restart=on-failure
RestartSec=5
StateDirectory=omarchy-sync
RuntimeDirectory=omarchy-sync
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/omarchy-sync /run/omarchy-sync

[Install]
WantedBy=multi-user.target
