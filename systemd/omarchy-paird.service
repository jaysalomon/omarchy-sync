[Unit]
Description=OmarchySync one-time trusted pairing listener
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/omarchy-sync/bin/omarchy-paird.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
