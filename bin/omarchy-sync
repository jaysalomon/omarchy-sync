#!/usr/bin/env bash
set -Eeuo pipefail

NAME=omarchy-sync
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-sync"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-sync"
SYNC_ROOT="$HOME/Sync/OmarchySync"

load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  # Config is a deliberately small shell-compatible key=value file.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  SYNC_ROOT="${sync_root:-$SYNC_ROOT}"
  SYNC_ROOT="${SYNC_ROOT//\$HOME/$HOME}"
}

init() {
  mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$SYNC_ROOT"/{common,machines,capabilities,conflicts}
  if [[ ! -f "$CONFIG_FILE" ]]; then
    sed "s|\$HOME|$HOME|g" "$(dirname "$0")/../config.example" > "$CONFIG_FILE"
  fi
  printf 'Initialized %s\n' "$SYNC_ROOT"
  printf 'Config: %s\n' "$CONFIG_FILE"
}

capabilities() {
  mkdir -p "$SYNC_ROOT/capabilities"
  local out="$SYNC_ROOT/capabilities/$(hostname).env"
  local gpu="none" mem="unknown" battery="none" fingerprint="no" cpu="unknown"
  command -v lscpu >/dev/null && cpu="$(lscpu -p=MODELNAME 2>/dev/null | sed '/^#/d' | head -1 | sed 's/[[:space:]]*$//')"
  command -v free >/dev/null && mem="$(free -b | awk '/^Mem:/ {print $2}')"
  command -v lspci >/dev/null && gpu="$(lspci 2>/dev/null | awk -F': ' '/VGA compatible controller|3D controller|Display controller/ {print $2}' | paste -sd ';' -)"
  compgen -G '/sys/class/power_supply/BAT*' >/dev/null && battery="yes"
  [[ -d /sys/class/fingerprint ]] && fingerprint="yes"
  {
    printf 'hostname=%q\n' "$(hostname)"
    printf 'user=%q\n' "$USER"
    printf 'cpu=%q\n' "$cpu"
    printf 'memory_bytes=%q\n' "$mem"
    printf 'gpu=%q\n' "$gpu"
    printf 'battery=%q\n' "$battery"
    printf 'fingerprint_reader=%q\n' "$fingerprint"
    printf 'updated_at=%q\n' "$(date --iso-8601=seconds)"
  } > "$out"
  chmod 600 "$out"
  printf '%s\n' "$out"
}

status() {
  load_config
  printf 'sync_root: %s\n' "$SYNC_ROOT"
  printf 'config: %s\n' "$CONFIG_FILE"
  printf 'peer: %s\n' "${peer_name:-not paired}"
  printf 'backend: %s\n' "${sync_backend:-auto}"
  if command -v syncthing >/dev/null; then
    printf 'syncthing: installed\n'
  else
    printf 'syncthing: not installed (safe/no-op mode)\n'
  fi
  [[ -f "$SYNC_ROOT/capabilities/$(hostname).env" ]] && printf 'capabilities: discovered\n' || printf 'capabilities: missing\n'
}

sync_once() {
  load_config
  capabilities >/dev/null
  if [[ "${sync_backend:-auto}" == "syncthing" || ( "${sync_backend:-auto}" == "auto" && $(command -v syncthing >/dev/null; echo $?) == 0 ) ]]; then
    printf 'Sync backend ready: Syncthing owns continuous file synchronization.\n'
    return 0
  fi
  printf 'No sync backend configured; state discovery completed without changing files.\n'
}

daemon() {
  local interval="${poll_seconds:-30}"
  while true; do
    sync_once
    sleep "$interval"
  done
}

install_service() {
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  mkdir -p "$unit_dir"
  cp "$(dirname "$0")/../systemd/omarchy-sync.service" "$unit_dir/omarchy-sync.service"
  systemctl --user daemon-reload
  systemctl --user enable --now omarchy-sync.service
  printf 'Installed and started omarchy-sync.service\n'
}

load_config
case "${1:-status}" in
  init) init ;;
  capabilities) capabilities ;;
  status) status ;;
  sync) sync_once ;;
  daemon) daemon ;;
  install-service) install_service ;;
  *) printf 'Usage: %s {init|capabilities|status|sync|daemon|install-service}\n' "$NAME" >&2; exit 2 ;;
esac
